{
	# No admin endpoint and no certificates inside the container: it runs as a non-root user and
	# writes nothing. TLS ends at the host's edge.
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	handle /health/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
