{
	# No admin endpoint and no certificates inside the container: it runs as a non-root user and
	# writes nothing. TLS ends at the host's edge.
	admin off
	auto_https off
}

# The API replicas. `dynamic a` asks DNS again every few seconds, so Compose's `api` name finds
# every replica that starts or stops (Caddy would otherwise resolve it once at start). A request
# whose connection to a replica fails is tried on the next one for a few seconds, and a replica
# that failed is skipped for a while. Only a failed connection is retried for every method; once a
# connection is made, only GET is. A replica that holds a connection but never answers (it died
# without closing it) would keep a request waiting for about 15 minutes, until the kernel gives up
# on the connection, so the first argument is the longest wait for the response headers.
(api_replicas) {
	dynamic a api 3000 {
		refresh 2s
	}
	transport http {
		response_header_timeout {args[0]}
	}
	lb_policy round_robin
	lb_try_duration 5s
	lb_try_interval 250ms
	fail_duration 10s
}

:8080 {
	encode zstd gzip

	# Scripts only from this origin, no inline script. Angular writes component styles into
	# <style> elements, so styles allow 'unsafe-inline'. The API shares the origin (fetch and SSE).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	# A probe answers within milliseconds: a short wait lets the retry reach the other replica.
	handle /health/* {
		reverse_proxy {
			import api_replicas 2s
		}
	}

	# The seat stream (text/event-stream) must reach the browser event by event: flush at once, never
	# hold a response back. `encode` leaves event streams uncompressed by itself (its default matcher
	# only takes compressible types).
	handle /api/* {
		reverse_proxy {
			import api_replicas 30s
			flush_interval -1
		}
	}

	# Presigned S3 downloads share the origin in Compose so the browser and E2E stack reach
	# the local AWS emulator without exposing its port.
	handle_path /storage/* {
		reverse_proxy aws:4566 {
			header_up Host aws:4566
		}
	}

	# Browser OTLP/HTTP trace exports share the origin so `connect-src 'self'` stays strict.
	handle /v1/traces {
		reverse_proxy tempo:4318
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
