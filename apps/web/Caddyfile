{
	# No admin endpoint and no certificates inside the container: it runs as a non-root user and
	# writes nothing. TLS ends at the host's edge.
	admin off
	auto_https off
}

# The API replicas. `dynamic a` asks DNS again every few seconds, so Compose's `api` name finds
# every replica that starts or stops (Caddy would otherwise resolve it once at start). A request
# whose connection to a replica fails is tried on the next one for a few seconds, and a replica
# that failed is skipped for a while. Only a failed connection is retried for every method; once a
# connection is made, only GET is.
(api_replicas) {
	dynamic a api 3000 {
		refresh 2s
	}
	lb_policy round_robin
	lb_try_duration 5s
	lb_try_interval 250ms
	fail_duration 10s
}

:8080 {
	encode zstd gzip

	# Scripts only from this origin, no inline script. Angular writes component styles into
	# <style> elements, so styles allow 'unsafe-inline'. The API shares the origin (fetch and SSE).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	handle /health/* {
		reverse_proxy {
			import api_replicas
		}
	}

	# The seat stream (text/event-stream) must reach the browser event by event: flush at once, never
	# hold a response back. `encode` leaves event streams uncompressed by itself (its default matcher
	# only takes compressible types).
	handle /api/* {
		reverse_proxy {
			import api_replicas
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
