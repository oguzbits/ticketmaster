# Template of the environment. Copy the values you need into your shell or your process manager;
# real env files are never committed. Every variable is validated in apps/api/src/config/env.ts.

# Port the API listens on.
PORT=3000

# Runtime mode: development, test or production. Outside production the connection URLs and the
# Keycloak URL and secret below fall back to the local containers; in production they are required.
NODE_ENV=development

# PostgreSQL connection URL. The Compose apps connect through PgBouncer
# (postgres://app_runtime:app_runtime@pgbouncer:5432/app); the one-shot migrate service connects directly.
# Runtime login (no superuser, no owner): row-level security applies to it.
# DATABASE_URL=postgres://app_runtime:app_runtime@localhost:54330/app
# Owner login, used only by `pnpm db:migrate`; it also creates the runtime role.
# MIGRATION_DATABASE_URL=postgres://app:app@localhost:54330/app

# Redis connection URL.
# REDIS_URL=redis://localhost:63790

# How long a held seat stays reserved, in seconds.
HOLD_TTL_SECONDS=600

# How long a cached event page lives in Redis, in seconds. 0 switches the cache off.
EVENT_CACHE_TTL_SECONDS=30

# Multiplies every rate limit (limit x scale). Keep 1; only the load-test Compose override raises it.
RATE_LIMIT_SCALE=1

# Share of fake payments that fail, from 0 to 1.
PAYMENT_FAILURE_RATE=0.1

# Origin allowed to call the API from a browser. Unset means no CORS headers (web and API share an
# origin behind Caddy).
# CORS_ORIGIN=http://localhost:4200

# Identity provider dialect: `keycloak` (default) or `cognito` (AWS Cognito User Pool).
# AUTH_PROVIDER=keycloak
# OIDC_ISSUER=
# OIDC_JWKS_URL=
# OIDC_CLIENT_ID=

# Keycloak base URL as the API reaches it (the token issuer is derived from it).
# KEYCLOAK_URL=http://localhost:8081

# Keycloak realm.
KEYCLOAK_REALM=ticketmaster

# Confidential client of the demo login (server only) and its secret. The local value is in
# docker/keycloak/ticketmaster-realm.json; production needs its own.
KEYCLOAK_DEMO_CLIENT_ID=api-demo
# KEYCLOAK_DEMO_CLIENT_SECRET=local-demo-client-secret

# How long a demo user lives before the worker deletes it, in seconds.
DEMO_USER_TTL_SECONDS=3600

# Enables the one-click demo login endpoint. Defaults to true locally, false in production.
# DEMO_LOGIN_ENABLED=true

# Enables unsafe comparison strategies (NAIVE). Defaults to true locally, false in production.
# UNSAFE_STRATEGIES_ENABLED=true

# HMAC-SHA256 signing secret (min 32 chars) for waiting-room admission tokens; required in production.
# WAITING_ROOM_SIGNING_SECRET=local-waiting-room-signing-secret-0000

# AWS-compatible services (SQS queues, S3 bucket). Outside production the endpoint, the dummy
# credentials and the region fall back to the local emulator; in production the credentials are
# required and an unset endpoint means real AWS.
# AWS_ENDPOINT_URL=http://localhost:45660
# Optional origin or path prefix used when returning presigned S3 ticket URLs (e.g. /storage).
# S3_PRESIGN_BASE_URL=/storage
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Mail transport: `ses` (AWS SESv2, default in production) or `smtp` (Mailpit locally, default outside production).
# MAIL_PROVIDER=smtp
# SMTP server URL when MAIL_PROVIDER=smtp. Outside production it falls back to local Mailpit.
# SMTP_URL=smtp://localhost:1025
MAIL_FROM=tickets@ticketmaster-klon.invalid

# Tracing (OpenTelemetry). Off by default. When on, spans go to an OTLP/HTTP receiver such as Tempo;
# '/v1/traces' is appended to the endpoint. The API and the worker must start with
# `node --import ./dist/tracing.preload.js dist/main.js` for the HTTP and queue spans.
TRACING_ENABLED=false
# TRACING_OTLP_ENDPOINT=http://localhost:4318
# Root trace sampling ratio (0 to 1): 1 locally, 0.05 in production by default.
# TRACING_SAMPLE_RATIO=1
# Metrics (OpenTelemetry, Prometheus format). Off by default. When on, the process serves `/metrics`
# on its own port (not the app port, not published by Compose). Start the API and the worker with
# `node --import ./dist/tracing.preload.js dist/main.js` here too.
METRICS_ENABLED=false
# METRICS_PORT=9464
# Interface of the listener; loopback unless the scraper is another container (Compose sets 0.0.0.0).
# METRICS_HOST=127.0.0.1
# Base URL of Grafana as the admin's browser reaches it. With tracing on, a finished run of the
# simulator links to its trace there; unset, no link is shown.
# GRAFANA_URL=http://localhost:3000
