# Template of the environment. Copy the values you need into your shell or your process manager;
# real env files are never committed. Every variable is validated in apps/api/src/config/env.ts.

# Port the API listens on.
PORT=3000

# Runtime mode: development, test or production. Outside production the connection URLs and the
# Keycloak URL and secret below fall back to the local containers; in production they are required.
NODE_ENV=development

# PostgreSQL connection URL.
# DATABASE_URL=postgres://app:app@localhost:54330/app

# Redis connection URL.
# REDIS_URL=redis://localhost:63790

# How long a held seat stays reserved, in seconds.
HOLD_TTL_SECONDS=600

# Share of fake payments that fail, from 0 to 1.
PAYMENT_FAILURE_RATE=0.1

# Origin allowed to call the API from a browser. Unset means no CORS headers (web and API share an
# origin behind Caddy).
# CORS_ORIGIN=http://localhost:4200

# Keycloak base URL as the API reaches it (the token issuer is derived from it).
# KEYCLOAK_URL=http://localhost:8081

# Keycloak realm.
KEYCLOAK_REALM=ticketmaster

# Confidential client of the demo login (server only) and its secret. The local value is in
# docker/keycloak/ticketmaster-realm.json; production needs its own.
KEYCLOAK_DEMO_CLIENT_ID=api-demo
# KEYCLOAK_DEMO_CLIENT_SECRET=local-demo-client-secret

# How long a demo user lives before the worker deletes it, in seconds.
DEMO_USER_TTL_SECONDS=3600

# AWS-compatible services (SQS queues, S3 bucket). Outside production the endpoint, the dummy
# credentials and the region fall back to the local emulator; in production the credentials are
# required and an unset endpoint means real AWS.
# AWS_ENDPOINT_URL=http://localhost:45660
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
